{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/what-is-exif",
      "destination": "/blog/photos-know-where-you-live",
      "permanent": true
    },
    {
      "source": "/blog/what-is-exif.html",
      "destination": "/blog/photos-know-where-you-live.html",
      "permanent": true
    },
    {
      "source": "/blog/stop-geotagging",
      "destination": "/blog/photos-know-where-you-live",
      "permanent": true
    },
    {
      "source": "/blog/stop-geotagging.html",
      "destination": "/blog/photos-know-where-you-live.html",
      "permanent": true
    },
    {
      "source": "/blog/keep-the-date-lose-the-location",
      "destination": "/blog/lossless-explained",
      "permanent": true
    },
    {
      "source": "/blog/keep-the-date-lose-the-location.html",
      "destination": "/blog/lossless-explained.html",
      "permanent": true
    },
    {
      "source": "/blog/pdf-metadata",
      "destination": "/blog/what-your-other-files-hide",
      "permanent": true
    },
    {
      "source": "/blog/pdf-metadata.html",
      "destination": "/blog/what-your-other-files-hide.html",
      "permanent": true
    },
    {
      "source": "/blog/raw-files-hide-a-jpeg",
      "destination": "/blog/what-your-other-files-hide",
      "permanent": true
    },
    {
      "source": "/blog/raw-files-hide-a-jpeg.html",
      "destination": "/blog/what-your-other-files-hide.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' blob:; frame-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://tile.openstreetmap.org; worker-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
